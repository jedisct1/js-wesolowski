{
	"name": "wesolowski-vdf",
	"version": "1.0.0",
	"description": "Wesolowski Verifiable Delay Function (VDF) implementation in TypeScript",
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"test": "bun test",
		"bench": "bun run benchmarks/vdf.ts",
		"typecheck": "tsc --noEmit",
		"example": "bun run examples/basic.ts"
	},
	"keywords": [
		"vdf",
		"verifiable-delay-function",
		"wesolowski",
		"cryptography",
		"rsa",
		"time-lock",
		"proof-of-time"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"engines": {
		"node": ">=18",
		"bun": ">=1.0"
	}
}
